# gbhook.ini: copy next to ghost.exe and edit. Nothing here is needed for a default install.
# Flat key = value. A '#' or ';' starts a comment, mid-line too. Double-quote a value to keep them.
# Lists are comma-separated.

# Where mods are looked for. Comma-separated, <gamedir>-relative or absolute.
mods_root = mods

# Mods to leave off, by id or folder name. The Mods page's Disable and Enable write this line.
# mods_disabled = mymod, SomeContentMod

# A mod's own settings live under its id, as <id>.<key>. The mod's previews/modinfo.ini
# lists the keys it reads and their defaults. A line here overrides one of them.
# mymod.spawn_rate = 12
