# gbhook.ini: copy next to ghost.exe and edit.
# Flat key = value. A '#' or ';' starts a comment, mid-line too, so a value cannot contain either.
# Lists are comma-separated. A [section] folds into the key as a prefix.

# Where mods are looked for. Comma-separated, <gamedir>-relative or absolute.
mods.root = mods

# A mod's own settings live under its id. gb.qol.bootskip = 0 turns off QoL's boot-screen skip.
